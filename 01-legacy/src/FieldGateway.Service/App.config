<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>

  <appSettings>
    <add key="DeviceConfigPath" value="C:\ProgramData\Indusoft\FieldGateway\devices.xml" />
    <add key="CachePath" value="C:\ProgramData\Indusoft\FieldGateway\cache.bin" />
    <add key="FirmwareStaging" value="C:\ProgramData\Indusoft\FieldGateway\firmware" />
    <!-- LEGACY-ISSUE: L04 Plaintext admin credentials and cloud API key in configuration (CWE-256, CWE-798) -->
    <add key="AdminUser" value="admin" />
    <add key="AdminPassword" value="Admin@123" />
    <add key="CloudApiKey" value="fg-live-7d1e5c0a9b3f4e2a8c6d0b1a2f3e4d5c" />
    <add key="CloudEndpoint" value="http://telemetry.indusoft-cloud.example/api/ingest" />
  </appSettings>

  <connectionStrings>
    <add name="Historian" connectionString="Data Source=HISTSRV01;Initial Catalog=FGHistorian;User ID=sa;Password=Hist0rian!2013" providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.serviceModel>
    <services>
      <service name="Indusoft.FieldGateway.Service.GatewayWcfService" behaviorConfiguration="DefaultBehavior">
        <!-- LEGACY-ISSUE: L05 BasicHttpBinding without transport security or client authentication; bound to all interfaces -->
        <endpoint address="http://0.0.0.0:8080/FieldGateway" binding="basicHttpBinding" bindingConfiguration="NoSecurity"
                  contract="Indusoft.FieldGateway.Service.IGatewayWcfService" />
        <endpoint address="http://0.0.0.0:8080/FieldGateway/mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>
    </services>
    <bindings>
      <basicHttpBinding>
        <binding name="NoSecurity" maxReceivedMessageSize="2147483647">
          <security mode="None" />
        </binding>
      </basicHttpBinding>
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <behavior name="DefaultBehavior">
          <serviceMetadata httpGetEnabled="true" />
          <!-- LEGACY-ISSUE: L08 Exception details (stack traces) returned to any caller -->
          <serviceDebug includeExceptionDetailInFaults="true" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>

  <log4net>
    <appender name="File" type="log4net.Appender.RollingFileAppender">
      <file value="C:\ProgramData\Indusoft\FieldGateway\logs\gateway.log" />
      <appendToFile value="true" />
      <maximumFileSize value="50MB" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
      </layout>
    </appender>
    <root>
      <level value="DEBUG" />
      <appender-ref ref="File" />
    </root>
  </log4net>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>
</configuration>
