<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Supply-chain hardening: single trusted source + package source mapping (prevents dependency confusion).
       Package signatures are verified in CI with `dotnet nuget verify` (see .github/workflows/cra-pipeline.yml). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
