<?xml version="1.0" encoding="utf-8"?>
<!-- v3 device configuration: no credentials; writable tags must declare engineering limits -->
<Gateway>
  <Device id="PLC1" name="Boiler PLC" ip="127.0.0.1" port="1502" unit="1" poll="500">
    <Tag name="Temperature" address="100" input="true" scale="0.1" unit="degC" />
    <Tag name="Pressure" address="101" input="true" scale="1" unit="mbar" />
    <Tag name="MotorSpeed" address="102" input="true" scale="1" unit="rpm" />
    <Tag name="Setpoint" address="10" scale="0.1" unit="degC" writable="true" min="20" max="90" />
  </Device>
</Gateway>
