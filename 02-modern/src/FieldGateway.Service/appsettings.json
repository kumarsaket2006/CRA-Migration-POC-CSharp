{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Management": {
        "Url": "https://127.0.0.1:8443",
        "Certificate": {
          "Subject": "fieldgateway.local",
          "Store": "My",
          "Location": "LocalMachine",
          "AllowInvalid": false
        }
      }
    }
  },
  "Gateway": {
    "DeviceConfigPath": "/var/lib/indusoft/fieldgateway/devices.xml",
    "CachePath": "/var/lib/indusoft/fieldgateway/cache.json",
    "FirmwareStagingPath": "/var/lib/indusoft/fieldgateway/firmware",
    "LicensePath": "/etc/indusoft/fieldgateway/license.json",
    "LicensePublicKeyPem": "",
    "FirmwarePublicKeysPem": [],
    "DeviceModels": { "PLC1": "IND-BOILER-CTRL-2" },
    "InstalledFirmware": { "PLC1": "4.1.0" },
    "Clients": [],
    "CacheFlushSeconds": 10
  },
  "CloudUplink": {
    "Enabled": false,
    "Endpoint": "https://telemetry.indusoft-cloud.example/api/ingest",
    "IntervalSeconds": 30
  }
}
